# ── eras and threads (the link to The Reckoner) ───────────────────────────
ERAS = [
    ('era-6',  'Era 6: Human Computers, Analog Machines & Theory', 1900, 1940),
    ('era-7',  'Era 7: The Electronic Breakthrough',               1940, 1955),
    ('era-8',  'Era 8: Computation Becomes Infrastructure',        1955, 1975),
    ('era-9',  'Era 9: Personal, Symbolic & Networked',            1975, 2005),
    ('era-10', 'Era 10: The Age of Massive Computation & AI',      2005, 9999),
]

# Keywords are a *proposal* only. Threads are editorial judgements about what a
# film is really about, which no keyword list can make — so nothing is written
# without review.
THREADS = {
    'thread-B': ('Human Computers',       r'human computer|computress|girls? who|hand[- ]comput|slide rule'),
    'thread-D': ('Machines',              r'\bengine\b|mechanic|gear|lathe|machine shop|clockwork|automat[oa]n'),
    'thread-G': ('Cryptography',          r'crypt|cipher|enigma|code[- ]break|secret writ|steganog'),
    'thread-H': ('The Art of Reckoning',  r'abacus|arithmetic|reckon|calculat|multiplic|logarithm|nomogram'),
    'thread-I': ('Computing with the World', r'analog|water clock|waterwheel|tide predict|differential analy|servo|feedback|hydraul|fluidic'),
    'thread-J': ('The Secret History',    r'navy|milit|defen[cs]e|missile|weapon|nuclear|bomb|classified|radar|war'),
    'thread-L': ('Teaching Math',         r'school|classroom|teach|student|pupil|lesson|educat|curricul'),
    'thread-M': ('The Signal',            r'telephone|telegraph|radio\b|televis|broadcast|satellite|network|signal|transmitter|transmission of (speech|sound|picture|televis)|transmitted by wire|microwave|coaxial'),
    'thread-N': ('When Computation Fails', r'fail|bug\b|crash|error|disaster|glitch|breakdown|blackout'),
    'thread-O': ('Memory',                r'memory|core\b|magnetic tape|drum|disk|storage|punch(ed)? card|record'),
    'thread-P': ('The Data Thread',       r'statistic|probabilit|census|survey|polling|data process|actuar'),
    'thread-Q': ('Labor & Automation',    r'automat|labor|labour|worker|factory|assembly|employ|union|job'),
    'thread-R': ('Commerce as Computation', r'bank|business|commerce|account|insur|payroll|inventory|retail|ledger'),
    'thread-S': ('The Card and the Link', r'punch(ed)? card|librar|catalog|index|hypertext|hypercard|filing|retriev'),
    'thread-T': ('The Harmony Thread',    r'music|sound|harmon|synthes[iz]|audio|acoustic|tone|voice|speech'),
    'thread-U': ('The Hermetic Thread',   r'occult|hermetic|alchem|astrolog|mystic|esoteric|divinat'),
}
_TC = {k: (n, re.compile(p, re.I)) for k, (n, p) in THREADS.items()}

def era_of(year):
    if not year:
        return None
    for eid, _t, a, b in ERAS:
        if a <= year < b:
            return eid
    return None

def propose_threads(f, limit=3):
    hay = ' '.join(filter(None, [f.get('title'), f.get('name'), f.get('chan')]))
    hits = []
    for eid, (name, pat) in _TC.items():
        m = pat.findall(hay)
        if m:
            hits.append((len(m), eid, name))
    hits.sort(key=lambda h: -h[0])
    return [(eid, name) for _n, eid, name in hits[:limit]]

REVIEW = 'tags-review.txt'

def cmd_tag(a):
    d = load()
    if a.apply:
        return _tag_apply(d, a)

    n_era = 0
    for f in d['films']:
        e = era_of(f.get('year'))
        if e and f.get('era') != e:
            f['era'] = e; n_era += 1
    save(d)
    print(f'eras: {n_era} film(s) placed from their year (deterministic, no review needed)')

    if a.eras_only:
        return 0

    rows = []
    for f in d['films']:
        if f.get('threads') and not a.all:
            continue
        props = propose_threads(f)
        if props:
            rows.append((f, props))
    if not rows:
        print('no thread proposals to review'); return 0

    path = os.path.join(ROOT, REVIEW)
    with open(path, 'w', encoding='utf-8') as fh:
        fh.write('# Thread proposals — these are guesses from keywords, not judgements.\n'
                 '#\n'
                 '#   keep a line to accept it        edit the letters to correct it\n'
                 '#   delete a line to reject it      then:  ./de tag --apply\n'
                 '#\n'
                 '# Threads: ' + '  '.join(sorted(k.split("-")[1] for k in THREADS)) + '\n#\n')
        for f, props in rows:
            letters = ','.join(p[0].split('-')[1] for p in props)
            names = ' / '.join(p[1] for p in props)
            fh.write(f'{letters:<8}{f["slug"]:<52}# {f["name"][:44]:<46}{names}\n')
    print(f'{len(rows)} proposals written to {REVIEW}')
    print(f'  edit it, then: ./de tag --apply')
    return 0

def _tag_apply(d, a):
    path = os.path.join(ROOT, REVIEW)
    if not os.path.exists(path):
        warn(f'{REVIEW} not found — run "de tag" first'); return 1
    by_slug = {f['slug']: f for f in d['films']}
    n, bad = 0, []
    for line in open(path, encoding='utf-8'):
        line = line.split('#')[0].rstrip()
        if not line.strip():
            continue
        parts = line.split()
        if len(parts) < 2:
            continue
        letters, slug = parts[0], parts[1]
        f = by_slug.get(slug)
        if not f:
            bad.append(slug); continue
        ids = [f'thread-{c.strip().upper()}' for c in letters.split(',') if c.strip()]
        ids = [i for i in ids if i in THREADS]
        if ids:
            f['threads'] = ids; n += 1
    save(d)
    print(f'tagged {n} film(s) with threads')
    if bad:
        warn(f'  {len(bad)} unknown slug(s) ignored, first: {bad[0]}')
    import collections as C
    c = C.Counter(t for f in d['films'] for t in (f.get('threads') or []))
    for k, v in c.most_common():
        print(f'   {v:4d}  {k}  {THREADS[k][0]}')
    return 0

# ── build ─────────────────────────────────────────────────────────────────
def esc(s): return html.escape(str(s if s is not None else ''), quote=True)

THEME = os.path.join(ROOT, 'theme.css')

def cmd_build(a):
    d = load()
    theme = open(THEME, encoding='utf-8').read() if os.path.exists(THEME) else ''
    if not theme:
        warn('theme.css not found — the page will be unstyled')
    films = d['films']
    if not films:
        warn('archive is empty — add something first'); return 1

    films.sort(key=lambda f: (f.get('year') or 9999, (f.get('name') or '').lower()))
    dated = [f for f in films if f.get('year')]
    ymin = min(f['year'] for f in dated) if dated else 0
    ymax = max(f['year'] for f in dated) if dated else 0

    # assets live at the repo root; a page built into watch/ must climb out
    depth = len([p for p in os.path.dirname(a.out).split(os.sep) if p and p != '.'])
    up = '../' * depth

    def img_of(f):
        if f.get('thumb'): return up + f['thumb']
        for k in ('360', 'med', '128'):
            if k in (f.get('images') or {}):
                return up + f['images'][k].replace('_Media/', 'media/')
        return ''

    out = []
    for f in films:
        rec = {
            'slug': f['slug'], 'title': f['title'], 'name': f.get('name') or f['title'],
            'year': f.get('year'), 'img': img_of(f), 'status': f.get('status', 'live'),
            'nLive': f.get('n_live', sum(1 for s in f['sources'] if s['status'] == 'live')),
            'collections': f.get('collections') or [],
            'sources': [{k: v for k, v in
                         dict(kind=s['kind'], id=s['id'], url=s['url'], embed=s['embed'],
                              status=s['status'], restored=s.get('restored'),
                              via=s.get('via'), reason=s.get('reason')).items()
                         if v is not None}
                        for s in f['sources']],
        }
        if f.get('dur'):  rec['dur'] = f['dur']
        if f.get('chan'): rec['chan'] = f['chan']
        if f.get('era'):  rec['era'] = f['era']
        if f.get('threads'): rec['threads'] = f['threads']
        if f.get('pan'):  rec['pan'] = 1
        out.append(rec)

    n_live = sum(1 for f in out if f['status'] == 'live')
    n_blk  = sum(1 for f in out if f['status'] == 'blocked')
    n_dead = sum(1 for f in out if f['status'] == 'dead')
    title = d.get('siteTitle', 'Dividing Engine')
    tag = d.get('tagline', 'Technology &middot; Science &middot; History')

    reckoner = {e: t for e, t, _a, _b in ERAS}
    reckoner.update({k: n for k, (n, _p) in THREADS.items()})
    data = json.dumps({'films': out, 'collections': d['collections'], 'siteTitle': title,
                       'reckoner': reckoner},
                      separators=(',', ':'), ensure_ascii=False).replace('</', '<\\/')

    used = sorted(set(c for f in out for c in f['collections']))
    opts = ['<option value="all">All collections</option>']
    for c in used:
        n = sum(1 for f in out if c in f['collections'])
        opts.append(f'<option value="{esc(c)}">{esc(d["collections"].get(c, {}).get("title", c))}'
                    f' ({n})</option>')
    if any(not f['collections'] for f in out):
        n = sum(1 for f in out if not f['collections'])
        opts.append(f'<option value="none">Uncollected ({n})</option>')
    coll_sel = (f'<select id="coll" aria-label="Collection">{"".join(opts)}</select>'
                if used else '<select id="coll" hidden></select>')

    page = f'''<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{esc(title)} — Technology, Science, History</title>
<meta name="description" content="A curated archive of {len(out)} technical, scientific and computing films{f", {ymin}–{ymax}" if dated else ""}.">
<link rel="icon" href="{up}favicon.ico">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Spectral:ital,wght@0,400;0,500;1,400&family=Cinzel:wght@400;500&display=swap">
<style>
{theme}
{CSS}
</style>
</head>
<body>

<header class="masthead"><div class="wrap">
<h1 class="wordmark"><a href="../">{esc(title)}</a></h1>
<p class="tagline">{tag}</p>
<nav class="halves">
<a href="../read/">Read</a><a href="./" aria-current="page">Watch</a>
</nav>
</div><div class="gradrule"></div></header>

<div class="wrap">
  <div class="scale-block"><div class="scale" id="scale"></div></div>

  <div class="controls">
    <div class="search">
      <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <circle cx="7" cy="7" r="4.6"/><path d="M10.5 10.5 14.5 14.5"/></svg>
      <input id="q" type="search" placeholder="Search {len(out)} films &mdash; press /" autocomplete="off" spellcheck="false" aria-label="Search films">
    </div>
    {coll_sel}
    <div class="seg" role="group" aria-label="Filter by availability">
      <button class="on" data-status="all" type="button">All</button>
      <button data-status="live" type="button">Playable</button>
      <button data-status="dead" type="button">Lost</button>
    </div>
    <div class="viewtog" role="group" aria-label="View">
      <button class="on" data-view="sheet" type="button">Sheet</button>
      <button data-view="list" type="button">Index</button>
    </div>
    <span class="count" id="count">{len(out)} films</span>
  </div>

  <ul class="sheet" id="sheet"></ul>
  <ul class="rows" id="rows" hidden></ul>
  <p class="more" id="more" hidden></p>
  <p class="empty" id="empty" hidden>No films match.</p>
</div>

<div class="veil" id="veil" role="dialog" aria-modal="true" aria-label="Film" hidden>
  <div class="sheetcard" id="card"></div>
</div>

<footer><div class="wrap"><div class="in">
<span>{len(out)} films{f", {ymin}&ndash;{ymax}" if dated else ""} &nbsp;&middot;&nbsp; {n_live} playable, {n_blk} off-site, {n_dead} lost</span>
<span><a href="../read/">The Reckoner &rarr;</a> &nbsp;&middot;&nbsp;
<button class="theme" type="button">Invert</button></span>
</div></div></footer>

<script>window.__FILMS__ = {data};</script>
<script>
{JS}
</script>
</body>
</html>
'''
    dest = os.path.join(ROOT, a.out)
    open(dest, 'w', encoding='utf-8').write(page)
    print(f'{a.out}: {len(page)/1024:.0f} KB, {len(out)} films '
          f'({n_live} playable, {n_blk} off-site, {n_dead} lost)')
    if len(page) > 3_000_000:
        warn('page is over 3 MB — consider splitting the data out of the HTML')
    return 0

# ── small commands ────────────────────────────────────────────────────────
def cmd_list(a):
    d = load()
    fs = d['films']
    if a.collection: fs = [f for f in fs if a.collection in f['collections']]
    if a.status:     fs = [f for f in fs if f.get('status') == a.status]
    for f in fs:
        vid = next((s['id'] for s in f['sources'] if s['kind'] == 'youtube'), '-')
        print(f"{str(f.get('year') or '····'):4s}  {f.get('status','?'):8s} {vid:12s} "
              f"{f['name'][:52]:54s} {','.join(f['collections'])}")
    print(f'\n{len(fs)} film(s)')
    return 0

def cmd_collections(a):
    d = load()
    for slug, c in sorted(d['collections'].items()):
        n = sum(1 for f in d['films'] if slug in f['collections'])
        print(f"  {slug:34s} {n:4d}  {c.get('title','')[:36]:38s} "
              f"{'playlist ' + c['playlist'] if c.get('playlist') else '(manual)'}")
    if not d['collections']: print('  (none)')
    return 0

def cmd_rm(a):
    d = load()
    before = len(d['films'])
    d['films'] = [f for f in d['films']
                  if f['slug'] != a.ref
                  and not any(s['id'] == a.ref for s in f['sources'])]
    save(d)
    print(f'removed {before - len(d["films"])} film(s)')
    return 0

def cmd_set(a):
    d = load()
    hit = [f for f in d['films']
           if f['slug'] == a.ref or any(s['id'] == a.ref for s in f['sources'])]
    if not hit: warn(f'no film matching {a.ref}'); return 1
    f = hit[0]
    if a.year is not None: f['year'] = a.year
    if a.name: f['name'] = a.name
    if a.add_collection:
        d['collections'].setdefault(a.add_collection,
                                    {'title': a.add_collection.replace('-', ' ').title(),
                                     'playlist': None, 'added': TODAY})
        if a.add_collection not in f['collections']: f['collections'].append(a.add_collection)
    save(d)
    print(f"{f['slug']}: year={f.get('year')} name={f['name']!r} "
          f"collections={f['collections']}")
    return 0

def main():
    p = argparse.ArgumentParser(prog='de', description='Dividing Engine archive tool')
    sub = p.add_subparsers(dest='cmd', required=True)

    s = sub.add_parser('add', help='add a video or playlist')
    s.add_argument('url'); s.add_argument('--collection'); s.add_argument('--title')
    s.add_argument('--playlist', action='store_true',
                   help='for a watch?v=..&list=.. URL, take the whole playlist')
    s.add_argument('--fast', action='store_true', help='skip per-video metadata')
    s.add_argument('--force', action='store_true', help='ingest even a truncated playlist')
    s.set_defaults(fn=cmd_add)

    s = sub.add_parser('sync', help='re-pull tracked playlists, add what is new')
    s.add_argument('--collection'); s.add_argument('--fast', action='store_true')
    s.add_argument('--force', action='store_true', help='ingest even a truncated playlist')
    s.set_defaults(fn=cmd_sync)

    s = sub.add_parser('check', help='verify videos still play')
    s.add_argument('--collection'); s.add_argument('--all', action='store_true')
    s.add_argument('--status', help='only recheck films with this status')
    s.add_argument('--deep', action='store_true',
                   help='also load embeds in a browser to catch newly un-embeddable videos')
    s.add_argument('--stale', type=int, default=30, help='recheck older than N days (default 30)')
    s.set_defaults(fn=cmd_check)

    s = sub.add_parser('enrich', help='fill in duration/channel/thumbnail for --fast adds')
    s.add_argument('--collection'); s.add_argument('--all', action='store_true')
    s.set_defaults(fn=cmd_enrich)

    s = sub.add_parser('title', help='tidy scraped YouTube titles')
    s.add_argument('--collection'); s.add_argument('--apply', action='store_true')
    s.add_argument('--all', action='store_true', help='include the hand-written originals')
    s.set_defaults(fn=cmd_title)

    s = sub.add_parser('year', help='backfill years from video descriptions')
    s.add_argument('--collection'); s.add_argument('--apply', action='store_true')
    s.add_argument('--limit', type=int)
    s.set_defaults(fn=cmd_year)

    s = sub.add_parser('tag', help='place films in Reckoner eras and threads')
    s.add_argument('--eras-only', action='store_true', help='only the deterministic era pass')
    s.add_argument('--apply', action='store_true', help='read back the reviewed proposals')
    s.add_argument('--all', action='store_true', help='re-propose even for already-tagged films')
    s.set_defaults(fn=cmd_tag)

    s = sub.add_parser('build', help='regenerate the page')
    s.add_argument('--out', default='index.html'); s.set_defaults(fn=cmd_build)

    s = sub.add_parser('list'); s.add_argument('--collection'); s.add_argument('--status')
    s.set_defaults(fn=cmd_list)
    sub.add_parser('collections').set_defaults(fn=cmd_collections)
    s = sub.add_parser('rm'); s.add_argument('ref'); s.set_defaults(fn=cmd_rm)
    s = sub.add_parser('set'); s.add_argument('ref'); s.add_argument('--year', type=int)
    s.add_argument('--name'); s.add_argument('--add-collection'); s.set_defaults(fn=cmd_set)

    a = p.parse_args()
    return a.fn(a)

if __name__ == '__main__':
    sys.exit(main() or 0)
