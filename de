def cmd_date(a):
    """A picker for the films whose year nobody knows yet."""
    import http.server, json as J, webbrowser, urllib.parse as UP
    d = load()
    todo = [f for f in d['films'] if not f.get('year') and f['status'] != 'dead']
    if a.collection:
        todo = [f for f in todo if a.collection in f['collections']]
    if a.limit:
        todo = todo[:a.limit]
    if not todo:
        print('every film already has a year'); return 0

    def guesses(f):
        """Years already visible in the title, offered as one-key answers."""
        out, t = [], f.get('title') or ''
        for m in re.finditer(r'\b(1[89]\d\d|20[0-2]\d)\b', t):
            y = int(m.group(1))
            if y not in out: out.append(y)
        for m in re.finditer(r"\b(1[89]|20)(\d)0s\b", t):
            y = int(m.group(1) + m.group(2) + '0')
            if y not in out: out.append(y)
        return out[:4]

    items = [{'slug': f['slug'], 'name': f.get('name') or f['title'],
              'img': f.get('thumb') or '', 'chan': f.get('chan') or '',
              'dur': (f'{f["dur"]//60}:{f["dur"]%60:02d}' if f.get('dur') else ''),
              'url': (f['sources'][0].get('url') if f.get('sources') else ''),
              'guess': guesses(f), 'hint': f.get('title') or ''}
             for f in todo]
    by_slug = {f['slug']: f for f in d['films']}
    done = {'n': 0}

    class H(http.server.BaseHTTPRequestHandler):
        def log_message(self, *a): pass
        def _send(self, code, body, ctype='text/html; charset=utf-8'):
            b = body.encode() if isinstance(body, str) else body
            self.send_response(code); self.send_header('Content-Type', ctype)
            self.send_header('Content-Length', str(len(b))); self.end_headers()
            self.wfile.write(b)
        def do_GET(self):
            if self.path == '/':
                self._send(200, DATE_REVIEW_HTML)
            elif self.path == '/data':
                self._send(200, J.dumps({'items': items}), 'application/json')
            elif self.path.startswith('/img/'):
                rel = UP.unquote(self.path[5:])
                p = os.path.normpath(os.path.join(ROOT, rel))
                if not p.startswith(ROOT) or not os.path.exists(p):
                    self._send(404, b'no', 'text/plain'); return
                ext = os.path.splitext(p)[1].lower()
                mime = {'.jpg': 'image/jpeg', '.jpeg': 'image/jpeg',
                        '.png': 'image/png', '.webp': 'image/webp'}.get(ext, 'application/octet-stream')
                self._send(200, open(p, 'rb').read(), mime)
            else:
                self._send(404, 'no')
        def do_POST(self):
            n = int(self.headers.get('Content-Length', 0))
            m = J.loads(self.rfile.read(n) or b'{}')
            f = by_slug.get(m.get('slug'))
            if f:
                y = m.get('year')
                if y:
                    f['year'] = int(y); f['year_source'] = 'hand'
                else:
                    f['year_skipped'] = True
                save(d); done['n'] += 1
            self._send(200, '{"ok":1}', 'application/json')

    srv = http.server.HTTPServer(('127.0.0.1', a.port), H)
    print(f'{len(items)} films need a year -> http://127.0.0.1:{a.port}/')
    print('type a year and press enter; s skips, o opens it on YouTube. Ctrl-C when done.')
    webbrowser.open(f'http://127.0.0.1:{a.port}/')
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print(f'\n{done["n"]} decision(s) saved. Next: ./build')
    return 0

