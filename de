# ── liveness ──────────────────────────────────────────────────────────────
def browser_check(vids, batch=6, wait=7000, port=8899):
    """Load each embed for real and report {vid: 'playable'|'unavailable'}.

    YouTube rejects embeds from a null origin, so this serves a throwaway page
    over http and reads the iframe. oEmbed alone is not trustworthy here: it
    returns 200 for videos that will not actually play.
    """
    try:
        from playwright.sync_api import sync_playwright
    except ImportError:
        warn('playwright not installed — falling back to oEmbed, which is less accurate.')
        warn('  python3 -m pip install --user playwright && python3 -m playwright install chromium')
        out = {}
        with cf.ThreadPoolExecutor(max_workers=8) as ex:
            for v, r in zip(vids, ex.map(oembed, vids)):
                out[v] = 'unavailable' if r.get('gone') else 'playable'
        return out

    import functools, http.server, socketserver, threading

    class Quiet(http.server.SimpleHTTPRequestHandler):
        def log_message(self, *a): pass

    handler = functools.partial(Quiet, directory=ROOT)
    socketserver.TCPServer.allow_reuse_address = True
    srv = socketserver.TCPServer(('127.0.0.1', port), handler)
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    tmp = os.path.join(ROOT, '_check.html')
    res = {}
    try:
        with sync_playwright() as pw:
            br = pw.chromium.launch()
            ctx = br.new_context(user_agent=UA, viewport={'width': 1200, 'height': 800})
            for n in range(0, len(vids), batch):
                chunk = vids[n:n + batch]
                open(tmp, 'w').write(
                    '<!doctype html><meta charset="utf-8"><body>' + ''.join(
                        f'<iframe id="f{i}" width="320" height="180" '
                        f'src="https://www.youtube-nocookie.com/embed/{v}?rel=0"></iframe>'
                        for i, v in enumerate(chunk)) + '</body>')
                pg = ctx.new_page()
                pg.goto(f'http://127.0.0.1:{port}/_check.html', wait_until='load')
                pg.wait_for_timeout(wait)
                for i, v in enumerate(chunk):
                    try:
                        fr = pg.query_selector(f'#f{i}').content_frame()
                        err = fr.query_selector('.ytp-error')
                        ok = fr.query_selector(
                            '.ytp-large-play-button, .ytp-cued-thumbnail-overlay, video')
                        res[v] = 'playable' if (ok and not err) else 'unavailable'
                    except Exception:
                        res[v] = 'unknown'
                pg.close()
                print(f'  checked {min(n + batch, len(vids))}/{len(vids)}', flush=True)
            br.close()
    finally:
        srv.shutdown()
        if os.path.exists(tmp): os.remove(tmp)
    return res

def cmd_check(a):
    d = load()
    films = d['films']
    if a.collection:
        films = [f for f in films if a.collection in f['collections']]
    if a.status:
        films = [f for f in films if f.get('status') == a.status]
    if not a.all and not a.status:
        cutoff = (dt.date.today() - dt.timedelta(days=a.stale)).isoformat()
        films = [f for f in films if not f.get('checked') or f['checked'] < cutoff]
    vids = sorted({s['id'] for f in films for s in f['sources'] if s['kind'] == 'youtube'})
    if not vids:
        print('nothing to check (use --all to force)'); return 0

    print(f'probing {len(vids)} videos over HTTP...', flush=True)
    t0 = dt.datetime.now()
    verdict, ambiguous = {}, []
    with cf.ThreadPoolExecutor(max_workers=24) as ex:
        for v, (st, more) in zip(vids, ex.map(cheap_status, vids)):
            verdict[v] = st
            if more: ambiguous.append(v)
    el = (dt.datetime.now() - t0).total_seconds()
    gone = [v for v, st in verdict.items() if st != 'live']
    print(f'  {el:.0f}s — {len(gone)} not playable, {len(ambiguous)} look live')

    # Only an actual embed tells a public-but-unembeddable video from a healthy
    # one, so that check is opt-in rather than the default.
    browser_saw = set()
    if a.deep and ambiguous:
        was_live = {v for f in d['films'] for s in f['sources']
                    if s['kind'] == 'youtube' and s['status'] == 'live'
                    for v in [s['id']]}
        todo = ambiguous if a.all else [v for v in ambiguous if v not in was_live]
        if todo:
            print(f'confirming {len(todo)} embeds in a browser...', flush=True)
            for v, r in browser_check(todo).items():
                browser_saw.add(v)
                if r == 'unavailable':
                    verdict[v] = 'embed-blocked'
                elif r == 'playable':
                    verdict[v] = 'live'
    elif ambiguous and not a.deep:
        print('  (run with --deep to confirm these actually embed)')

    why = {}
    if gone:
        with cf.ThreadPoolExecutor(max_workers=8) as ex:
            for v, t in zip(gone, ex.map(reason, gone)):
                why[v] = t

    changed = 0
    for f in d['films']:
        touched = False
        for s in f['sources']:
            if s['kind'] != 'youtube' or s['id'] not in verdict:
                continue
            new = verdict[s['id']]
            # The cheap pass cannot see "public but will not embed", so it must
            # not promote a browser-confirmed embed-blocked video back to live.
            if (new == 'live' and s['status'] == 'embed-blocked'
                    and s['id'] not in browser_saw):
                continue
            if new == 'live':
                s.pop('reason', None)
            elif why.get(s['id']):
                s['reason'] = why[s['id']]
            if new != s['status']:
                s['status'] = new; changed += 1
            touched = True
        if touched:
            live = [s for s in f['sources'] if s['status'] == 'live']
            blocked = [s for s in f['sources'] if s['status'] == 'embed-blocked']
            f['status'] = 'live' if live else ('blocked' if blocked else 'dead')
            f['n_live'] = len(live); f['n_total'] = len(f['sources'])
            f['checked'] = TODAY
    save(d)
    import collections as C
    print(f'\n{changed} source status change(s)')
    print('entries:', dict(C.Counter(f['status'] for f in d['films'])))
    return 0

