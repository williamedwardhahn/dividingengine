_TC = {k: (n, re.compile(p, re.I)) for k, (n, p) in THREADS.items()}

def era_of(year):
    if not year:
        return None
    for eid, _t, a, b in ERAS:
        if a <= year < b:
            return eid
    return None

def propose_threads(f, limit=3):
    hay = ' '.join(filter(None, [f.get('title'), f.get('name'), f.get('chan')]))
    hits = []
    for eid, (name, pat) in _TC.items():
        m = pat.findall(hay)
        if m:
            hits.append((len(m), eid, name))
    hits.sort(key=lambda h: -h[0])
    return [(eid, name) for _n, eid, name in hits[:limit]]

