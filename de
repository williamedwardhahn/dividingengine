    for f in d['films']:
        if f.get('threads') and not a.all:
            continue
        props = propose_threads(f)
        if props:
            rows.append((f, props))
    if not rows:
        print('no thread proposals to review'); return 0

    path = os.path.join(ROOT, REVIEW)
    with open(path, 'w', encoding='utf-8') as fh:
        fh.write('# Thread proposals — these are guesses from keywords, not judgements.\n'
                 '#\n'
                 '#   keep a line to accept it        edit the letters to correct it\n'
                 '#   delete a line to reject it      then:  ./de tag --apply\n'
                 '#\n'
                 '# Threads: ' + '  '.join(sorted(k.split("-")[1] for k in THREADS)) + '\n#\n')
        for f, props in rows:
            letters = ','.join(p[0].split('-')[1] for p in props)
            names = ' / '.join(p[1] for p in props)
            fh.write(f'{letters:<8}{f["slug"]:<52}# {f["name"][:44]:<46}{names}\n')
    print(f'{len(rows)} proposals written to {REVIEW}')
    print(f'  edit it, then: ./de tag --apply')
    return 0

def _tag_apply(d, a):
    path = os.path.join(ROOT, REVIEW)
    if not os.path.exists(path):
        warn(f'{REVIEW} not found — run "de tag" first'); return 1
    by_slug = {f['slug']: f for f in d['films']}
    n, bad = 0, []
    for line in open(path, encoding='utf-8'):
        line = line.split('#')[0].rstrip()
        if not line.strip():
            continue
        parts = line.split()
        if len(parts) < 2:
            continue
        letters, slug = parts[0], parts[1]
        f = by_slug.get(slug)
        if not f:
            bad.append(slug); continue
        ids = [f'thread-{c.strip().upper()}' for c in letters.split(',') if c.strip()]
        ids = [i for i in ids if i in THREADS]
        if ids:
            f['threads'] = ids; n += 1
    save(d)
    print(f'tagged {n} film(s) with threads')
    if bad:
        warn(f'  {len(bad)} unknown slug(s) ignored, first: {bad[0]}')
    import collections as C
    c = C.Counter(t for f in d['films'] for t in (f.get('threads') or []))
    for k, v in c.most_common():
        print(f'   {v:4d}  {k}  {THREADS[k][0]}')
    return 0

def cmd_list(a):
    d = load()
    fs = d['films']
    if a.collection: fs = [f for f in fs if a.collection in f['collections']]
    if a.status:     fs = [f for f in fs if f.get('status') == a.status]
    for f in fs:
        vid = next((s['id'] for s in f['sources'] if s['kind'] == 'youtube'), '-')
        print(f"{str(f.get('year') or '····'):4s}  {f.get('status','?'):8s} {vid:12s} "
              f"{f['name'][:52]:54s} {','.join(f['collections'])}")
    print(f'\n{len(fs)} film(s)')
    return 0

def cmd_collections(a):
    d = load()
    for slug, c in sorted(d['collections'].items()):
        n = sum(1 for f in d['films'] if slug in f['collections'])
        print(f"  {slug:34s} {n:4d}  {c.get('title','')[:36]:38s} "
              f"{'playlist ' + c['playlist'] if c.get('playlist') else '(manual)'}")
    if not d['collections']: print('  (none)')
    return 0

def find_film(d, ref):
    """A film by slug or by any source id."""
    hit = [f for f in d['films']
           if f['slug'] == ref or any(s['id'] == ref for s in f['sources'])]
    return hit[0] if hit else None

def cmd_thumb(a):
    """Replace a film's thumbnail. Source of truth stays archive.json + media/yt/.

    Four ways to say which picture:
      --variant maxres|hq|mq|sd|1|2|3   one of YouTube's own stills (1/2/3 are the
                                       three auto-picked frames; default fetch is hq)
      --url URL                        any image on the web
      --file PATH                      a picture on disk
      --at SECONDS                     grab that frame of the video (needs yt-dlp + ffmpeg)
      --reset                          re-fetch the default (maxres→hq→mq), overwriting
    The file lands at media/yt/<video id>.jpg (or media/yt/<slug>.jpg if the film has
    no YouTube source) and the film's `thumb` points at it. Run `./de build` after.
    """
    d = load()
    f = find_film(d, a.ref)
    if not f: warn(f'no film matching {a.ref}'); return 1
    vid = next((s['id'] for s in f['sources'] if s.get('kind') == 'youtube'), None)
    os.makedirs(YTDIR, exist_ok=True)
    dest = os.path.join(YTDIR, f'{vid or f["slug"]}.jpg')
    rel = os.path.relpath(dest, ROOT)
    chosen = sum(bool(x) for x in (a.variant, a.url, a.file, a.at is not None, a.reset))
    if chosen != 1:
        warn('say exactly one of --variant / --url / --file / --at / --reset'); return 1
    data = None
    if a.reset:
        if not vid: warn('no YouTube source to reset from'); return 1
        got = fetch_thumb(vid, force=True)
        if not got: warn('YouTube served no thumbnail'); return 1
        f['thumb'] = got; save(d); print(f"{f['slug']}: thumb reset -> {got}"); return 0
    if a.variant:
        if not vid: warn('--variant needs a YouTube source'); return 1
        names = {'maxres': 'maxresdefault', 'hq': 'hqdefault', 'mq': 'mqdefault',
                 'sd': 'sddefault', '1': '1', '2': '2', '3': '3'}
        if a.variant not in names: warn(f'variant must be one of {", ".join(names)}'); return 1
        a.url = f'https://i.ytimg.com/vi/{vid}/{names[a.variant]}.jpg'
    if a.url:
        try:
            r = urllib.request.Request(a.url, headers={'User-Agent': UA})
            data = urllib.request.urlopen(r, timeout=30).read()
        except Exception as e:
            warn(f'could not fetch {a.url}: {e}'); return 1
        if len(data) < 1500: warn('fetched image is too small to be real (YouTube placeholder?)'); return 1
    elif a.file:
        if not os.path.exists(a.file): warn(f'no such file: {a.file}'); return 1
        data = open(a.file, 'rb').read()
        if not a.file.lower().endswith(('.jpg', '.jpeg')):
            # keep the archive uniform: convert through Pillow if present, else refuse
            try:
                from PIL import Image
                import io
                im = Image.open(io.BytesIO(data)).convert('RGB')
                buf = io.BytesIO(); im.save(buf, 'JPEG', quality=88); data = buf.getvalue()
            except ImportError:
                warn('not a JPEG and Pillow is not installed; convert it first'); return 1
    elif a.at is not None:
        if not vid: warn('--at needs a YouTube source'); return 1
        import shutil, subprocess, tempfile
        ytdlp = os.path.join(ROOT, '.venv', 'bin', 'yt-dlp')
        if not os.path.exists(ytdlp): ytdlp = shutil.which('yt-dlp')
        ffmpeg = shutil.which('ffmpeg')
        if not (ytdlp and ffmpeg):
            warn('--at needs yt-dlp (in .venv) and ffmpeg on PATH; use --variant/--url/--file instead'); return 1
        try:
            stream = subprocess.run([ytdlp, '-g', '-f', 'best[height<=720]',
                                     f'https://www.youtube.com/watch?v={vid}'],
                                    capture_output=True, text=True, timeout=120).stdout.strip().splitlines()[0]
            tmp = tempfile.NamedTemporaryFile(suffix='.jpg', delete=False).name
            subprocess.run([ffmpeg, '-y', '-loglevel', 'error', '-ss', str(a.at), '-i', stream,
                            '-frames:v', '1', '-q:v', '2', tmp], check=True, timeout=180)
            data = open(tmp, 'rb').read(); os.unlink(tmp)
        except Exception as e:
            warn(f'frame grab failed: {e}'); return 1
    if not data: warn('nothing to write'); return 1
    if os.path.exists(dest):
        # lossless: keep the previous picture beside the new one, once
        prev = dest[:-4] + '.prev.jpg'
        if not os.path.exists(prev): os.replace(dest, prev)
    open(dest, 'wb').write(data)
    f['thumb'] = rel
    save(d)
    print(f"{f['slug']}: thumb -> {rel} ({len(data)//1024} KB). Now: ./de build")
    return 0

def cmd_rm(a):
    d = load()
    before = len(d['films'])
    d['films'] = [f for f in d['films']
                  if f['slug'] != a.ref
                  and not any(s['id'] == a.ref for s in f['sources'])]
    save(d)
    print(f'removed {before - len(d["films"])} film(s)')
    return 0

def cmd_set(a):
    d = load()
    hit = [f for f in d['films']
           if f['slug'] == a.ref or any(s['id'] == a.ref for s in f['sources'])]
    if not hit: warn(f'no film matching {a.ref}'); return 1
    f = hit[0]
    if a.year is not None: f['year'] = a.year
    if a.name: f['name'] = a.name
    if a.add_collection:
        d['collections'].setdefault(a.add_collection,
                                    {'title': a.add_collection.replace('-', ' ').title(),
                                     'playlist': None, 'added': TODAY})
        if a.add_collection not in f['collections']: f['collections'].append(a.add_collection)
    save(d)
    print(f"{f['slug']}: year={f.get('year')} name={f['name']!r} "
          f"collections={f['collections']}")
    return 0

def main():
    p = argparse.ArgumentParser(prog='de', description='Dividing Engine archive tool')
    sub = p.add_subparsers(dest='cmd', required=True)

    s = sub.add_parser('add', help='add a video or playlist')
    s.add_argument('url'); s.add_argument('--collection'); s.add_argument('--title')
    s.add_argument('--playlist', action='store_true',
                   help='for a watch?v=..&list=.. URL, take the whole playlist')
    s.add_argument('--fast', action='store_true', help='skip per-video metadata')
    s.add_argument('--force', action='store_true', help='ingest even a truncated playlist')
    s.set_defaults(fn=cmd_add)

    s = sub.add_parser('sync', help='re-pull tracked playlists, add what is new')
    s.add_argument('--collection'); s.add_argument('--fast', action='store_true')
    s.add_argument('--force', action='store_true', help='ingest even a truncated playlist')
    s.set_defaults(fn=cmd_sync)

    s = sub.add_parser('check', help='verify videos still play')
    s.add_argument('--collection'); s.add_argument('--all', action='store_true')
    s.add_argument('--status', help='only recheck films with this status')
    s.add_argument('--deep', action='store_true',
                   help='also load embeds in a browser to catch newly un-embeddable videos')
    s.add_argument('--stale', type=int, default=30, help='recheck older than N days (default 30)')
    s.set_defaults(fn=cmd_check)

    s = sub.add_parser('enrich', help='fill in duration/channel/thumbnail for --fast adds')
    s.add_argument('--collection'); s.add_argument('--all', action='store_true')
    s.set_defaults(fn=cmd_enrich)

    s = sub.add_parser('title', help='tidy scraped YouTube titles')
    s.add_argument('--collection'); s.add_argument('--apply', action='store_true')
    s.add_argument('--all', action='store_true', help='include the hand-written originals')
    s.set_defaults(fn=cmd_title)

    s = sub.add_parser('date', help='date the undated films by hand, fast')
    s.add_argument('--port', type=int, default=8913); s.add_argument('--limit', type=int)
    s.add_argument('--collection')
    s.set_defaults(fn=cmd_date)

    s = sub.add_parser('year', help='backfill years from video descriptions')
    s.add_argument('--collection'); s.add_argument('--apply', action='store_true')
    s.add_argument('--limit', type=int)
    s.set_defaults(fn=cmd_year)

    s = sub.add_parser('tag', help='place films in the timeline eras and threads')
    s.add_argument('--eras-only', action='store_true', help='only the deterministic era pass')
    s.add_argument('--apply', action='store_true', help='read back the reviewed proposals')
    s.add_argument('--all', action='store_true', help='re-propose even for already-tagged films')
    s.set_defaults(fn=cmd_tag)

    s = sub.add_parser('list'); s.add_argument('--collection'); s.add_argument('--status')
    s.set_defaults(fn=cmd_list)
    sub.add_parser('collections').set_defaults(fn=cmd_collections)
    s = sub.add_parser('thumb', help='replace a film\'s thumbnail (variant, url, file, frame, or reset)')
    s.add_argument('ref', help='film slug or YouTube id')
    s.add_argument('--variant', help='maxres|hq|mq|sd|1|2|3 (YouTube stills)')
    s.add_argument('--url'); s.add_argument('--file')
    s.add_argument('--at', type=float, help='seconds into the video (needs yt-dlp + ffmpeg)')
    s.add_argument('--reset', action='store_true', help='re-fetch the default thumbnail')
    s.set_defaults(fn=cmd_thumb)
    s = sub.add_parser('rm'); s.add_argument('ref'); s.set_defaults(fn=cmd_rm)
    s = sub.add_parser('set'); s.add_argument('ref'); s.add_argument('--year', type=int)
    s.add_argument('--name'); s.add_argument('--add-collection'); s.set_defaults(fn=cmd_set)

    a = p.parse_args()
    return a.fn(a)

if __name__ == '__main__':
    sys.exit(main() or 0)
