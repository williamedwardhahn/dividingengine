def cmd_review(a):
    db = load()
    visits = [a.visit] if a.visit else list(db['visits'])
    if not visits or any(v not in db['visits'] for v in visits):
        sys.exit('museum: scan a folder first')

    byid, exhibits = {}, []
    for v in visits:
        info = db['visits'][v]
        for e in info['exhibits']:
            shots = [db['photos'][s]['when'] for s in e['shots'] if s in db['photos']]
            rec = {'id': f'{v}:{e["id"]}', 'visit': v, 'title': e['title'],
                   'body': e['body'], 'shots': shots}
            byid[rec['id']] = rec
            exhibits.append(rec)

    photos = []
    for p in sorted(db['photos'].values(), key=lambda p: p['when']):
        if p['visit'] not in visits or p['kind'] != 'object':
            continue
        if p.get('keep') is not None and not a.all:
            continue
        photos.append({'file': p['file'], 'when': p['when'], 'gap': p.get('gap'),
                       'exhibit': f'{p["visit"]}:{p["exhibit"]}' if p.get('exhibit') else None,
                       'visit': p['visit']})
    if not photos:
        print('every photograph is reviewed — ./museum fetch'); return
    # doubtful pairings first: they are the ones that need a human
    photos.sort(key=lambda p: (-(p['gap'] or 0), p['when']))

    data = {'photos': photos, 'exhibits': exhibits, 'byid': byid}
    page = REVIEW_HTML.replace('__DATA__', json.dumps(data))
    thumbdirs = {v: CACHE / v for v in visits}

    class H(BaseHTTPRequestHandler):
        def log_message(self, *a): pass

        def do_GET(self):
            if self.path.startswith('/img/'):
                stem = self.path[5:]
                for d in thumbdirs.values():
                    f = d / (stem + '.jpg')
                    if f.exists():
                        b = f.read_bytes()
                        self.send_response(200)
                        self.send_header('Content-Type', 'image/jpeg')
                        self.send_header('Content-Length', str(len(b)))
                        self.end_headers(); self.wfile.write(b); return
                self.send_error(404); return
            b = page.encode()
            self.send_response(200)
            self.send_header('Content-Type', 'text/html; charset=utf-8')
            self.send_header('Content-Length', str(len(b)))
            self.end_headers(); self.wfile.write(b)

        def do_POST(self):
            n = int(self.headers.get('Content-Length', 0))
            body = json.loads(self.rfile.read(n) or b'{}')
            cur = load()
            rec = cur['photos'].get(body.get('file'))
            if not rec:
                self.send_error(404); return
            if 'keep' in body:
                rec['keep'] = bool(body['keep'])
            if body.get('exhibit'):
                rec['exhibit'] = body['exhibit'].split(':', 1)[1]
            save(cur)
            self.send_response(200); self.send_header('Content-Length', '2')
            self.end_headers(); self.wfile.write(b'ok')

    srv = HTTPServer(('127.0.0.1', 8931), H)
    url = 'http://127.0.0.1:8931/'
    print(f'{len(photos)} to review at {url}   (K keep · X skip · 1-9 re-label)')
    print('ctrl-c when you are done')
    threading.Timer(0.4, lambda: webbrowser.open(url)).start()
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        db = load()
        done = sum(1 for p in db['photos'].values() if p.get('keep') is not None)
        kept = sum(1 for p in db['photos'].values() if p.get('keep'))
        print(f'\n{done} reviewed, {kept} kept — ./museum fetch')


def main():
    ap = argparse.ArgumentParser(prog='museum', description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest='cmd', required=True)

    s = sub.add_parser('scan', help='read a folder of museum photographs')
    s.add_argument('folder'); s.add_argument('--visit')
    s.set_defaults(fn=cmd_scan)

    s = sub.add_parser('review', help='confirm the pairings')
    s.add_argument('--visit'); s.add_argument('--all', action='store_true',
                                              help='include already-reviewed')
    s.set_defaults(fn=cmd_review)

    s = sub.add_parser('fetch', help='compress the kept photographs in')
    s.add_argument('--visit'); s.set_defaults(fn=cmd_fetch)

    s = sub.add_parser('status', help='what is paired, kept, archived')
    s.set_defaults(fn=cmd_status)

    a = ap.parse_args()
    a.fn(a)


if __name__ == '__main__':
    main()
