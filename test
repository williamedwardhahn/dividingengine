#!/usr/bin/env python3
"""
Dividing Engine — test suite.

    ./test              data, sources, build output, assets  (fast, no network)
    ./test --browser    also drive the built page in Chromium
    ./test --net        also check a sample of embeds are still reachable
    ./test --deploy     also compare local index.html against what Pages serves

Every check is something that has actually broken here at least once.
"""
import argparse, json, os, re, subprocess, sys, tempfile, pathlib, collections

ROOT = pathlib.Path(__file__).parent.resolve()
os.chdir(ROOT)

_pass, _fail, _skip = 0, [], 0
def check(name, cond, detail=''):
    global _pass
    if cond:
        _pass += 1
        print(f'  \033[32m✓\033[0m {name}')
    else:
        _fail.append((name, detail))
        print(f'  \033[31m✗\033[0m {name}' + (f'\n      {detail}' if detail else ''))
def skip(name, why):
    global _skip
    _skip += 1
    print(f'  \033[90m·\033[0m {name} — {why}')
def section(t): print(f'\n\033[1m{t}\033[0m')

# ── the archive ───────────────────────────────────────────────────────────
def test_archive():
    section('archive.json')
    d = json.loads((ROOT / 'archive.json').read_text(encoding='utf-8'))
    films = d['films']
    check('parses and is non-empty', len(films) > 0, f'{len(films)} films')

    slugs = [f['slug'] for f in films]
    dupe = [s for s, n in collections.Counter(slugs).items() if n > 1]
    check('slugs are unique', not dupe, f'duplicates: {dupe[:3]}')
    check('every film has a title', all((f.get('title') or '').strip() for f in films),
          str([f['slug'] for f in films if not (f.get('title') or '').strip()][:3]))
    check('every film has at least one source', all(f.get('sources') for f in films),
          str([f['slug'] for f in films if not f.get('sources')][:3]))

    VALID = {'live', 'dead', 'blocked'}
    bad = [f['slug'] for f in films if f.get('status') not in VALID]
    check('film statuses are valid', not bad, f'bad: {bad[:3]}')
    SVALID = {'live', 'dead', 'embed-blocked'}
    bads = [(f['slug'], s['status']) for f in films for s in f['sources'] if s['status'] not in SVALID]
    check('source statuses are valid', not bads, f'bad: {bads[:3]}')

    # a film is live iff it has a live source — this drifted once
    wrong = [f['slug'] for f in films
             if (f['status'] == 'live') != any(s['status'] == 'live' for s in f['sources'])]
    check('status agrees with its sources', not wrong, f'{len(wrong)} disagree: {wrong[:3]}')

    dead_live = [f['slug'] for f in films
                 if f['status'] == 'dead' and any(s['status'] == 'live' for s in f['sources'])]
    check('no dead film holds a live source', not dead_live, str(dead_live[:3]))

    yrs = [f['year'] for f in films if f.get('year')]
    import datetime
    now = datetime.date.today().year
    odd = [f['slug'] for f in films if f.get('year') and not (1870 <= f['year'] <= now)]
    check('years are plausible', not odd, f'odd: {odd[:3]}')

    vids = [s['id'] for f in films for s in f['sources'] if s['kind'] == 'youtube']
    badid = [v for v in vids if not re.fullmatch(r'[\w-]{11}', v)]
    check('youtube ids are well formed', not badid, f'bad: {badid[:3]}')
    dupv = [v for v, n in collections.Counter(vids).items() if n > 1]
    check('no video appears in two films', not dupv, f'duplicated: {dupv[:3]}')
    return films

# ── the narrative source ──────────────────────────────────────────────────
def test_master_list():
    section('the master list')
    md = (ROOT / 'the-reckoner' / 'history-of-computation-master-list.md')
    check('master list exists', md.exists())
    if not md.exists(): return []
    import importlib.util
    spec = importlib.util.spec_from_file_location('rb', ROOT / 'the-reckoner' / 'build.py')
    rb = importlib.util.module_from_spec(spec)
    cwd = os.getcwd(); os.chdir(ROOT / 'the-reckoner')
    spec.loader.exec_module(rb); os.chdir(cwd)
    stacks = rb.parse(md.read_text(encoding='utf-8'))
    check('parses into stacks', len(stacks) > 20, f'{len(stacks)} stacks')
    n = sum(len(s['cards']) for s in stacks)
    check('parses a plausible number of cards', n > 400, f'{n} cards')
    empt = [(s['id'], i) for s in stacks for i, c in enumerate(s['cards'])
            if not (c.get('t') or '').strip()]
    check('no card has an empty title', not empt, f'{len(empt)} empty: {empt[:3]}')
    ids = [s['id'] for s in stacks]
    check('stack ids are unique', len(set(ids)) == len(ids))
    return stacks

# ── pictures and the catalogue ────────────────────────────────────────────
def test_pictures():
    section('pictures')
    p = ROOT / 'pics.json'
    if not p.exists():
        skip('picture archive', 'no pics.json yet'); return
    db = json.loads(p.read_text(encoding='utf-8'))
    have = {k: v for k, v in db.items() if v.get('img')}
    missing = [k for k, v in have.items() if not (ROOT / v['img']).exists()]
    check('every recorded picture exists on disk', not missing,
          f'{len(missing)} missing: {missing[:3]}')
    # An image with no recorded licence cannot legally be published — and a blank
    # licence used to slip past the attribution check below, because it matched
    # neither BY nor anything else.
    nolic = [v['card'] for v in have.values() if not (v.get('lic') or '').strip()]
    check('every picture records its licence', not nolic,
          f'{len(nolic)}: {nolic[:3]}')
    # CC BY / BY-SA require crediting the author; an unattributed file is a bug
    noattr = [v['card'] for v in have.values()
              if re.search(r'\bBY\b', v.get('lic', ''), re.I) and not (v.get('by') or v.get('via'))]
    check('CC-BY pictures carry an attribution', not noattr,
          f'{len(noattr)}: {noattr[:2]}')
    if have:
        sizes = [(ROOT / v['img']).stat().st_size for v in have.values()
                 if (ROOT / v['img']).exists()]
        big = [s for s in sizes if s > 300_000]
        check('no picture blows the size budget', not big,
              f'{len(big)} over 300 KB, largest {max(sizes)//1024 if sizes else 0} KB')
        avg = sum(sizes) / max(1, len(sizes))
        print(f'      ({len(sizes)} pictures, {avg/1024:.0f} KB average, '
              f'{sum(sizes)/1e6:.1f} MB total)')

def test_dataphys():
    section('dataphys catalogue')
    p = ROOT / 'dataphys.json'
    if not p.exists():
        skip('dataphys', 'not present'); return
    d = json.loads(p.read_text(encoding='utf-8'))
    src = d.get('source', {})
    check('the source is credited', bool(src.get('by') and src.get('url')), str(src)[:80])
    e = d['entries']
    check('entries are present', len(e) > 50, f'{len(e)} entries')
    check('every entry is dated no later than 2000',
          all(x['year'] <= 2000 for x in e),
          str([x['title'] for x in e if x['year'] > 2000][:3]))
    check('every entry links back to its source entry',
          all(x.get('href', '').startswith('https://dataphys.org/list/') for x in e))
    check('no entry duplicates a master-list card',
          not [x for x in e if x['title'] in
               {'Ishango Bone', 'Mesopotamian Clay Tokens', 'Water Clocks'}])

# ── the build ─────────────────────────────────────────────────────────────
def test_build():
    section('build')
    r = subprocess.run([sys.executable, 'build-site.py'], capture_output=True, text=True)
    check('build-site.py runs clean', r.returncode == 0, r.stderr[-300:])
    out = ROOT / 'index.html'
    check('index.html written', out.exists())
    h = out.read_text(encoding='utf-8')

    check('no unresolved template placeholders',
          '/*__THEME__*/' not in h and '/*__DATA__*/' not in h)
    check('theme tokens are inlined', '--rubric' in h and '--brass' in h)
    check('is branded Dividing Engine',
          'Dividing Engine' in h and 'The Reckoner' not in h.replace('Ready-Reckoner', ''))
    check('the name is explained', 'Jesse Ramsden' in h and 'difference engine' in h.lower())
    check('the mission is stated', 'history of computing' in h.lower())
    check('no read/watch split remains', 'class="halves"' not in h)

    m = re.search(r'const STACKS\s*=\s*(\{.*?\})\s*;?\s*\n', h, re.S) or \
        re.search(r'/\*__DATA__\*/|STACKS\s*=\s*(\{.*)', h)
    data = None
    mm = re.search(r'(\{"stacks":.*?\})\s*[;,]?\s*\n', h, re.S)
    if mm:
        try: data = json.loads(mm.group(1).replace('<\\/', '</'))
        except Exception: data = None
    if data is None:
        skip('inline data parses as JSON', 'could not locate the data blob')
    else:
        stacks = data['stacks']
        check('inline data parses as JSON', True)
        cards = [c for s in stacks for c in s['cards']]
        films = [c for c in cards if c.get('kindc') == 'film']
        check('cards and films are both present',
              len(cards) > 1000 and len(films) > 700, f'{len(cards)} cards, {len(films)} film')
        dp = [c for c in cards if c.get('kindc') == 'dataphys']
        check('the catalogue cards made it in', len(dp) > 50, f'{len(dp)} dataphys cards')
        uncredited = [c['t'] for c in dp if 'dataphys.org' not in (c.get('b') or '')]
        check('every catalogue card credits its source', not uncredited,
              f'{len(uncredited)}: {uncredited[:2]}')
        # the cross-link graph: this is what makes it hypermedia and not a slideshow
        addr = {f"{s['id']}/{n}" for s in stacks for n in range(len(s['cards']))}
        out_n = sum(len(c.get('out') or []) for c in cards)
        check('cards cross-link to each other', out_n > 200, f'{out_n} links')
        dangling = [x['to'] for c in cards for x in (c.get('out') or []) + (c.get('in') or [])
                    if x['to'] not in addr]
        check('every link points at a real card', not dangling, f'{dangling[:3]}')
        unlabelled = [x['to'] for c in cards for x in (c.get('out') or []) + (c.get('in') or [])
                      if not (x.get('t') or '').strip() or x.get('t') == 'Overview']
        check('no link is labelled "Overview"', not unlabelled, f'{len(unlabelled)}')
        filmtargets = [x['to'] for c in cards for x in (c.get('out') or [])
                       if x['to'] in {f"{s['id']}/{n}" for s in stacks
                                      for n, cc in enumerate(s['cards'])
                                      if cc.get('kindc') == 'film'}]
        check('films are not link targets', not filmtargets, f'{len(filmtargets)}')
        hub = max((len(c.get('in') or []) for c in cards), default=0)
        check('no card is a runaway hub', hub <= 20, f'busiest has {hub} inbound')
        print(f'      ({out_n} cross-links; '
              f'{sum(1 for c in cards if c.get("in"))} cards reached from others)')

        # the book apparatus
        app = data.get('app') or {}
        toc, ix, gl = app.get('contents') or [], app.get('index') or {}, app.get('glossary') or []
        check('contents covers every stack', len(toc) >= len(stacks) - 1,
              f'{len(toc)} of {len(stacks)}')
        check('contents lists every card',
              sum(t['n'] for t in toc) >= len(cards) - 6,
              f"{sum(t['n'] for t in toc)} vs {len(cards)}")
        check('the index has entries', len(ix) > 400, f'{len(ix)} entries')
        ixbad = [k for k, v in ix.items() for r in v if r['to'] not in addr]
        check('every index entry points at a real card', not ixbad, f'{ixbad[:3]}')
        check('the glossary has entries', len(gl) > 200, f'{len(gl)} entries')
        glbad = [g['t'] for g in gl if g['to'] not in addr or not g.get('g')]
        check('every glossary entry resolves and has a gloss', not glbad, f'{glbad[:3]}')
        print(f'      ({len(toc)} stacks, {len(ix)} index entries, {len(gl)} glossary entries)')

        pics = [c for c in cards if c.get('img') and c.get('kindc') != 'film']
        print(f'      ({len(pics)} narrative cards carry a picture)')
        # a film that died before we ever fetched its thumbnail cannot have one;
        # anything still reachable must.
        noimg = [c['t'] for c in films if not c.get('img') and c.get('status') != 'dead']
        check('every reachable film has a frame', not noimg, f'{len(noimg)}: {noimg[:2]}')
        deadnoimg = sum(1 for c in films if not c.get('img'))
        print(f'      ({deadnoimg} lost films have no frame — nothing to fetch)')
        live_noembed = [c['t'] for c in films if c.get('status') == 'live' and not c.get('emb')]
        check('every playable film has an embed url', not live_noembed,
              f'{len(live_noembed)}: {live_noembed[:2]}')
        # a film must land in an era whose range contains its year
        ERAS = {'era-6': (1900, 1940), 'era-7': (1940, 1955), 'era-8': (1955, 1975),
                'era-9': (1975, 2005), 'era-10': (2005, 9999)}
        wrong = []
        for s in stacks:
            if s['id'] not in ERAS: continue
            a, b = ERAS[s['id']]
            for c in s['cards']:
                if c.get('kindc') == 'film' and c.get('d'):
                    y = int(c['d'])
                    if not (a <= y < b): wrong.append((c['t'][:28], y, s['id']))
        check('films sit in the era matching their year', not wrong, f'{len(wrong)}: {wrong[:2]}')
        undated = [s for s in stacks if s['id'] == 'undated']
        check('undated films have a home', len(undated) == 1,
              'expected exactly one "undated" stack')
    return h

# ── assets ────────────────────────────────────────────────────────────────
def test_assets(h):
    section('assets')
    refs = set(re.findall(r'"(media/[^"]+)"', h)) | set(re.findall(r'url\("([^"]+)"\)', h))
    refs = {r for r in refs if not r.startswith(('data:', 'http'))}   # inline SVG, CDN fonts
    missing = sorted(r for r in refs if not (ROOT / r).exists())
    check('every referenced asset exists on disk', not missing,
          f'{len(missing)} missing: {missing[:3]}')
    check('the original banner is present', (ROOT / 'assets' / 'banner.png').exists())
    check('favicon is present', (ROOT / 'favicon.ico').exists())
    orphan_ok = True
    check('CNAME points at the domain',
          (ROOT / 'CNAME').exists() and
          (ROOT / 'CNAME').read_text().strip() == 'dividingengine.com')
    check('.nojekyll present (Pages must not skip _-prefixed dirs)',
          (ROOT / '.nojekyll').exists())
    check('.venv is not tracked',
          '.venv' in (ROOT / '.gitignore').read_text())

# ── the page, driven for real ─────────────────────────────────────────────
def test_browser():
    section('browser')
    try:
        from playwright.sync_api import sync_playwright
    except ImportError:
        skip('browser checks', 'playwright not installed'); return
    import http.server, socketserver, threading, functools, contextlib
    class Quiet(http.server.SimpleHTTPRequestHandler):
        def log_message(self, *a): pass
    socketserver.TCPServer.allow_reuse_address = True
    srv = socketserver.TCPServer(('127.0.0.1', 8911),
                                 functools.partial(Quiet, directory=str(ROOT)))
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    try:
        with sync_playwright() as pw:
            br = pw.chromium.launch()
            pg = br.new_page(viewport={'width': 1300, 'height': 900})
            errs = []
            pg.on('pageerror', lambda e: errs.append(str(e)))
            pg.on('console', lambda m: errs.append(m.text) if m.type == 'error' else None)
            pg.goto('http://127.0.0.1:8911/', wait_until='load'); pg.wait_for_timeout(800)

            check('lands on the film sheet', not pg.is_hidden('#sheetview'))
            n = pg.eval_on_selector_all('#sheet li', 'e=>e.length')
            check('sheet renders a first page', n > 50, f'{n} tiles')
            check('sheet counts every film', 'FILMS' in pg.inner_text('#scount').upper(),
                  pg.inner_text('#scount'))

            pg.fill('#sq', 'voder'); pg.wait_for_timeout(350)
            got = pg.inner_text('#scount')
            check('sheet search narrows', 'OF' in got.upper(), got)
            pg.fill('#sq', ''); pg.wait_for_timeout(250)

            pg.click('#sheet li:nth-child(3) a'); pg.wait_for_timeout(700)
            check('clicking a tile opens its card', bool(pg.query_selector('.cardtitle')))
            check('that card is a film', bool(pg.query_selector('.film, .filmgone')))
            check('the card names its stack', 'ERA' in pg.inner_text('#stacklbl').upper(),
                  pg.inner_text('#stacklbl')[:40])

            pg.click('button[data-act="sheet"]'); pg.wait_for_timeout(400)
            check('Films returns to the sheet', not pg.is_hidden('#sheetview'))

            pg.click('button[data-act="find"]'); pg.wait_for_timeout(200)
            pg.keyboard.type('babbage'); pg.keyboard.press('Enter'); pg.wait_for_timeout(500)
            check('Find reaches the narrative', bool(pg.query_selector('.cardtitle')),
                  pg.inner_text('#stacklbl')[:40])

            pg.goto('http://127.0.0.1:8911/#era-7/0', wait_until='load'); pg.wait_for_timeout(600)
            check('deep links resolve', 'ERA 7' in pg.inner_text('#stacklbl').upper(),
                  pg.inner_text('#stacklbl')[:40])

            for view in ('contents', 'index', 'glossary'):
                pg.goto(f'http://127.0.0.1:8911/#{view}', wait_until='load')
                pg.wait_for_timeout(500)
                check(f'{view} renders', len(pg.inner_text('#content')) > 400)
            import re as _re
            pg.goto('http://127.0.0.1:8911/#era-2/0', wait_until='load'); pg.wait_for_timeout(400)
            check('thread references read as names, not letters',
                  not _re.search(r'\bThread [A-Z]\b', pg.inner_text('body')))

            # Back must retrace the trail. It used to keep its own stack beside
            # the browser's, which could only ever disagree with it.
            def _where():
                if not pg.is_hidden('#sheetview'): return 'sheet'
                el = pg.query_selector('.cardtitle')
                return el.inner_text()[:26] if el else 'BLANK'
            pg.goto('http://127.0.0.1:8911/', wait_until='load'); pg.wait_for_timeout(600)
            fwd = [_where()]
            pg.locator('#sheet li a').first.click(); pg.wait_for_timeout(500); fwd.append(_where())
            pg.locator('#nextb').click(); pg.wait_for_timeout(500); fwd.append(_where())
            pg.locator('button[data-act="glossary"]').click(); pg.wait_for_timeout(600)
            rev = []
            for _ in range(3):
                pg.locator('button[data-act="back"]').click(); pg.wait_for_timeout(500)
                rev.append(_where())
            check('Back retraces the trail', rev == list(reversed(fwd)),
                  f'{fwd} then back {rev}')
            check('the sheet has its own address',
                  pg.evaluate("(()=>{document.querySelector('[data-act=sheet]').click();"
                              "return location.hash})()") == '#films')

            check('no console or page errors', not errs, str(errs[:2]))
            br.close()
    finally:
        srv.shutdown()

# ── network (opt-in) ──────────────────────────────────────────────────────
def test_net(films):
    section('network (sample)')
    import urllib.request, urllib.error, random
    from concurrent.futures import ThreadPoolExecutor
    live = [s['id'] for f in films if f['status'] == 'live'
            for s in f['sources'] if s['kind'] == 'youtube' and s['status'] == 'live']
    sample = random.sample(live, min(24, len(live)))
    def ok(v):
        try:
            urllib.request.urlopen(urllib.request.Request(
                f'https://i.ytimg.com/vi/{v}/mqdefault.jpg',
                headers={'User-Agent': 'Mozilla/5.0'}, method='HEAD'), timeout=15)
            return True
        except Exception:
            return False
    with ThreadPoolExecutor(max_workers=12) as ex:
        res = list(ex.map(ok, sample))
    bad = [v for v, o in zip(sample, res) if not o]
    check(f'sample of {len(sample)} "live" films still have thumbnails', not bad,
          f'gone: {bad[:4]} — run ./de check')

def test_deploy():
    """Compare the live site against the local build.

    Resolved explicitly against GitHub's Pages addresses rather than the system
    resolver, so a stale local DNS cache cannot turn a real check into a skip.
    """
    section('deploy parity')
    import hashlib, socket, ssl
    local = hashlib.sha256((ROOT / 'index.html').read_bytes()).hexdigest()
    PAGES = ['185.199.108.153', '185.199.109.153', '185.199.110.153', '185.199.111.153']
    host = 'dividingengine.com'

    def fetch(ip):
        ctx = ssl.create_default_context()
        with socket.create_connection((ip, 443), timeout=30) as raw:
            with ctx.wrap_socket(raw, server_hostname=host) as s_:
                s_.sendall(f'GET / HTTP/1.1\r\nHost: {host}\r\n'
                           f'User-Agent: de-test\r\nConnection: close\r\n\r\n'.encode())
                buf = b''
                while True:
                    chunk = s_.recv(65536)
                    if not chunk: break
                    buf += chunk
        head, _, body = buf.partition(b'\r\n\r\n')
        status = int(head.split(b' ')[1])
        if b'chunked' in head.lower():                 # de-chunk
            out, rest = b'', body
            while rest:
                ln, _, rest = rest.partition(b'\r\n')
                n = int(ln.split(b';')[0], 16)
                if not n: break
                out += rest[:n]; rest = rest[n + 2:]
            body = out
        return status, body

    body = code = None
    err = ''
    for ip in PAGES:
        try:
            code, body = fetch(ip); break
        except Exception as e:
            err = str(e)[:60]
    if body is None:
        skip('deploy parity', f'could not reach Pages: {err}'); return
    check('the live site responds 200', code == 200, f'got {code}')
    served = hashlib.sha256(body).hexdigest()
    check('deployed page matches the local build', served == local,
          'the build has moved on — commit and push')

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--browser', action='store_true')
    ap.add_argument('--net', action='store_true')
    ap.add_argument('--deploy', action='store_true')
    ap.add_argument('--all', action='store_true')
    a = ap.parse_args()
    if a.all: a.browser = a.net = a.deploy = True

    films = test_archive()
    test_master_list()
    test_pictures()
    test_dataphys()
    h = test_build()
    test_assets(h)
    if a.browser: test_browser()
    else: skip('browser checks', 'pass --browser')
    if a.net: test_net(films)
    else: skip('network checks', 'pass --net')
    if a.deploy: test_deploy()
    else: skip('deploy parity', 'pass --deploy')

    print(f'\n\033[1m{_pass} passed, {len(_fail)} failed, {_skip} skipped\033[0m')
    for n, d in _fail:
        print(f'  \033[31mFAIL\033[0m {n}' + (f' — {d}' if d else ''))
    return 1 if _fail else 0

if __name__ == '__main__':
    sys.exit(main())
