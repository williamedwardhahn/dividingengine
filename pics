def cmd_review(a):
    """Serve a picker. Reading 500 filenames is slow; looking at 500 pictures is not."""
    import http.server, json as J, webbrowser
    cf_path = ROOT / '.pics-candidates.json'
    if not cf_path.exists():
        warn('no candidates — run ./pics propose first'); return 1
    cands = J.loads(cf_path.read_text(encoding='utf-8'))
    db = load()
    pending = {k: v for k, v in cands.items() if k not in db and v.get('cands')}
    if not pending:
        print('nothing left to review'); return 0
    picked = {'n': 0}

    class H(http.server.BaseHTTPRequestHandler):
        def log_message(self, *a): pass
        def _send(self, code, body, ctype='text/html; charset=utf-8'):
            b = body.encode() if isinstance(body, str) else body
            self.send_response(code); self.send_header('Content-Type', ctype)
            self.send_header('Content-Length', str(len(b))); self.end_headers()
            self.wfile.write(b)
        def do_GET(self):
            if self.path == '/':      self._send(200, REVIEW_HTML)
            elif self.path == '/data': self._send(200, J.dumps({'cands': pending}),
                                                  'application/json')
            else: self._send(404, 'no')
        def do_POST(self):
            n = int(self.headers.get('Content-Length', 0))
            msg = J.loads(self.rfile.read(n) or b'{}')
            k, i = msg.get('k'), msg.get('i')
            if k in pending:
                meta = pending[k]
                if i == -1:
                    db[k] = {'skip': True, 'card': meta['card']}
                else:
                    c = meta['cands'][i]
                    db[k] = {'card': meta['card'], 'stack': meta['stack'], 'pick': c,
                             'img': f'media/cards/{k}.webp'}
                save(db); picked['n'] += 1
            self._send(200, '{"ok":1}', 'application/json')

    srv = http.server.HTTPServer(('127.0.0.1', a.port), H)
    print(f'{len(pending)} cards to review -> http://127.0.0.1:{a.port}/')
    print('pick one picture per card (or Skip). Ctrl-C when done; choices save as you click.')
    webbrowser.open(f'http://127.0.0.1:{a.port}/')
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print(f'\n{picked["n"]} decision(s) saved. Next: ./pics fetch')
    return 0

def cmd_status(a):
    db = load()
    cards = all_cards()
    have = sum(1 for sid, _st, c in cards if db.get(key(sid, c['t']), {}).get('img'))
    skip = sum(1 for sid, _st, c in cards if db.get(key(sid, c['t']), {}).get('skip'))
    print(f'narrative cards : {len(cards)}')
    print(f'  with a picture: {have}')
    print(f'  skipped       : {skip}')
    print(f'  undecided     : {len(cards) - have - skip}')
    if OUTDIR.exists():
        fs = list(OUTDIR.glob('*.webp'))
        tot = sum(f.stat().st_size for f in fs)
        print(f'archive         : {len(fs)} files, {tot/1e6:.1f} MB, '
              f'{tot/max(1,len(fs))/1024:.0f} KB average')
    import collections
    lic = collections.Counter(v.get('lic') for v in db.values() if v.get('img'))
    if lic:
        print('licences        :')
        for k, v in lic.most_common(): print(f'   {v:4d}  {k}')
    return 0

def cmd_recompress(a):
    """Re-encode the archive from source at the current settings."""
    db = load()
    todo = [(k, v) for k, v in db.items() if v.get('img')]
    print(f're-fetching and re-encoding {len(todo)}...', flush=True)
    before = sum((ROOT / v['img']).stat().st_size for _k, v in todo
                 if (ROOT / v['img']).exists())
    def one(item):
        k, v = item
        pk = v.get('pick') or v
        url = pk.get('url') or v.get('src')
        if not url: return 0
        try:
            r = urllib.request.Request(url, headers={'User-Agent': UA})
            return compress(urllib.request.urlopen(r, timeout=90).read(),
                            OUTDIR / f'{k}.webp')
        except Exception:
            return 0
    with cf.ThreadPoolExecutor(max_workers=4) as ex:
        after = sum(ex.map(one, todo))
    print(f'{before/1e6:.1f} MB -> {after/1e6:.1f} MB')
    return 0

def main():
    ap = argparse.ArgumentParser(prog='pics')
    sub = ap.add_subparsers(dest='cmd', required=True)
    s = sub.add_parser('propose'); s.add_argument('--limit', type=int); s.set_defaults(fn=cmd_propose)
    s = sub.add_parser('review'); s.add_argument('--port', type=int, default=8912)
    s.set_defaults(fn=cmd_review)
    sub.add_parser('fetch').set_defaults(fn=cmd_fetch)
    sub.add_parser('status').set_defaults(fn=cmd_status)
    sub.add_parser('recompress').set_defaults(fn=cmd_recompress)
    a = ap.parse_args()
    return a.fn(a)

if __name__ == '__main__':
    sys.exit(main() or 0)
